# libray-app's Supabase project (same variable names as expense-split's .env).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_DB_PASSWORD="your-db-password"
# Optional (pooler / CI): SUPABASE_DB_HOST (or SUPABASE_HOST), SUPABASE_DB_PORT, SUPABASE_DB_USER (or SUPABASE_USER)=postgres.<project-ref>
