{
  "name": "@libray/backend",
  "version": "0.1.0",
  "description": "Backend API for libray-app",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push:pg",
    "db:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "@libray/shared": "*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "drizzle-orm": "^0.28.1",
    "pg": "^8.11.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.1",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.2.2",
    "tsx": "^4.1.0",
    "vitest": "^0.34.6",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "drizzle-kit": "^0.19.13",
    "eslint": "^8.50.0"
  }
}
